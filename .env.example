# Run `pnpm tsx scripts/setup-local.ts` to generate .env with random local secrets.
PORT=8760
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8760
DATABASE_URL=
POSTGRES_PASSWORD=
AUTH_SECRET=
# 32 bytes, base64. Encrypts persisted x402 payment payloads at rest.
PAYLOAD_KEY=
# Comma-separated origins allowed to call the public API from a browser.
TRUSTED_ORIGINS=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=8764
MAIL_FROM=Platform <accounts@localhost.test>

# x402. FACILITATOR is "cdp" (needs CDP_API_KEY_ID and CDP_API_KEY_SECRET) or a URL.
FACILITATOR=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Receiving addresses. Public addresses only; their keys are the owner's.
PAY_TO_EVM=
PAY_TO_SOLANA=
# Our own RPCs for independent reconciliation.
EVM_RPC_URL=
EVM_NETWORK=eip155:84532
EVM_USDC=
EVM_CONFIRMATIONS=3
SOLANA_RPC_URL=
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_USDC=
